// ### DEFAULT - Top ### //
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 1,
"fixed-center": true,
"ipc": true,
"margin-top": 2,
"margin-left": 2,
"margin-right": 2,

"modules-left": [
    "group/app_drawer",
    "custom/separator#line",
    "hyprland/workspaces#rw",
	"mpris",
	],

"modules-center": [
	"group/notify",
	"clock#4",
	"custom/separator#blank_2",	
	],

"modules-right": [
    "temperature",
    "custom/separator#line",
    "custom/gpu",
    "custom/separator#line",
    "cpu",
	"custom/separator#line",
	"memory",
	"custom/separator#line",
	"tray",
	"custom/separator#line",
	"power-profiles-daemon",
	"custom/separator#line",
	"backlight",
    "custom/separator#line",
    "battery",
	"custom/separator#line", 
	"group/status",
	],
}
